t-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0"><br data-ref="e966a9ea-d18f-4864-bcfc-0d38ccd7e4ac"></p><p data-ref="200422fc-2c81-4090-a1b8-564191e29f8d" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">If the main() is provided with arguments : 1.34, 1.98 then the program should print the output as:</p><p data-ref="059bcd23-ee45-497a-b5a2-b086403d49b8" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">Area of square for side in meters 1.34 : 1.7956</p><p data-ref="902dad97-92c8-4455-b4b7-5a2dbb02191f" data-counter-list-1-reset="0" data-counter-reset="list-1 list-2 list-3 list-4 list-5 list-6 list-7 list-8 list-9" data-counter-list-2-reset="0" data-counter-list-3-reset="0" data-counter-list-4-reset="0" data-counter-list-5-reset="0" data-counter-list-6-reset="0" data-counter-list-7-reset="0" data-counter-list-8-reset="0" data-counter-list-9-reset="0">Area of rectangle for length and breadth in meters 1.34, 1.98 : 2.6532001</p></span></div><div class="mb-3" data-ref="ff808f79-24a9-4d40-9cb7-68d0cc4b4df5"><div class="ml-1 mb-3" data-ref="837a12f9-0d57-4996-8aef-8a4fd508e6e4"><b style="border-bottom:1px solid black;" data-ref="5eeefd59-743a-44bf-b618-a7f3961fe42e" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="2aefdb67-300c-4b1a-a283-0e9ee14e7b30" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="0ce3fecd-91ef-4e3e-b5f4-4b150f729e8a" data-undisplayed="undisplayed">OverloadArea.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="04e89d71-c716-4b8c-9093-51d61fa5b583" data-undisplayed="undisplayed">// Type Content here...
class OverloadArea {
	void area(float side) {
		float result = side * side;
		System.out.printf("Area of square for side in meters %.2f: %.4f%n",side, result);
	}
	void area(float length, float breadth) {
		float result = length * breadth;

		System.out.printf("Area of rectangle for length and breadth in meters %.2f, %.2f: %.7f%n",length, breadth, result);
	}
	public static void main(String args[]) {
		float a = Float.parseFloat(args[0]);
		float b = Float.parseFloat(args[1]);
		OverloadArea obj = new
			OverloadArea();
		obj.area(a);
		obj.area(a, b);
	}
}</pre><br data-ref="2146fbf8-7b9d-4083-911d-ee46cc480054"></div></div></div></div></div></div></div></div>
