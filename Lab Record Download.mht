import java.lang.*;
class InvalidWeight extends Exception {
	InvalidWeight(String message){
		super(message);
	}
}
class CheckWeight {
	void validWeight(int weight) throws InvalidWeight{
		if(weight &gt; 100){
			throw new InvalidWeight(weight + " is invalid weight\n");
		}else{
			System.out.print(weight + " is the valid weight\n");
		}
		}

	public static void main(String args[]) {
		CheckWeight cw = new CheckWeight();
		Scanner sc = new Scanner(System.in);
		int weight;
		System.out.print("Enter weight: ");
		weight = sc.nextInt();
		try {
			cw.validWeight(weight);
		} catch(InvalidWeight iw) {
			System.out.print("Exception caught: " + iw.getMessage());
		}
	}
	
}
