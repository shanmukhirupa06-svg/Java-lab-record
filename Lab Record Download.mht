class OverloadArea {
	void area(float side) {
		float result = side * side;
		System.out.printf("Area of square for side in meters %.2f: %.4f%n",side, result);
	}
	void area(float length, float breadth) {
		float result = length * breadth;

		System.out.printf("Area of rectangle for length and breadth in meters %.2f, %.2f: %.7f%n",length, breadth, result);
	}
	public static void main(String args[]) {
		float a = Float.parseFloat(args[0]);
		float b = Float.parseFloat(args[1]);
		OverloadArea obj = new
			OverloadArea();
		obj.area(a);
