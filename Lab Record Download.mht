l-font-monospace" data-ref="625f1586-375e-494e-b0e0-a9797651f72e">start()</span><strong data-ref="cdfd5ba0-0827-4aae-ac9d-8094123da064">.</strong></li><li data-ref="acbb371e-c35c-409e-94fb-ed119a1bd2b9">Refer to visible test cases for better understanding and to match with input/output layout.</li></ul></span></div><div class="mb-3" data-ref="2db22256-dff3-4efd-9b25-43a24e1ac391"><div class="ml-1 mb-3" data-ref="06f56c6c-d58f-4006-939e-1484c74a2490"><b style="border-bottom:1px solid black;" data-ref="eeb46402-b136-401f-acbd-bcc814360b9c" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="5e416f1b-61b4-4cda-b071-0758201649f4" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="1cc0e26e-59be-4e10-a3ff-330ead31c646" data-undisplayed="undisplayed">DaemonThread.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="a29ba3a1-7d53-4a56-841e-cfbdb27ef326" data-undisplayed="undisplayed">import java.util.Scanner;

class WorkerThread extends Thread {
	
	// Write your code here...
	private int threadId;
    
    WorkerThread(int id){
        threadId = id;
    }
    
    public void run(){
        System.out.println("Thread " + threadId + " started");
        try {
            for(int i = 0; i &lt; 2; i++){
                Thread.sleep(200);
            }
            System.out.println("Thread " + threadId + " finished");
        } catch(InterruptedException e) {
            System.out.println("Thread " + threadId + "interrupted: " + e);
        }
    }

}

public class DaemonThread {
	public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the number of user threads: ");
        int numUserThreads = scanner.nextInt();

        System.out.print("Enter the number of daemon threads: ");
        int numDaemonThreads = scanner.nextInt();
        int id = 1;
    for (int i = 0; i &lt; numUserThreads; i++) {
        WorkerThread userThread = new WorkerThread(id++);
        userThread.start();
    }
    
    id = 1;
    for (int i = 0; i &lt; numDaemonThreads; i++) {
        WorkerThread daemonThread = new WorkerThread(id++);
        daemonThread.setDaemon(true);
        daemonThread.start();
	}
        
        
        
        
