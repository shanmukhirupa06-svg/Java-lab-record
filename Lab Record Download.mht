import java.util.Scanner;


// Write your code here for threads
// Definition of FirstThread extending Thread class
class FirstThread extends Thread {
	private int count;
    
    public FirstThread(int count){
        this.count=count;
    }
    
    public void run(){
        for(int i=1;i&lt;=count;i++){
            System.out.println("Message from First Thread: "+i);
            try{
                Thread.sleep(100);
            }catch(InterruptedException e){
                System.out.println("FirstThread interrupted: "+e);
            }
        }
    }

}
class SecondThread extends Thread {
	private int count;
    
    public SecondThread(int count){
        this.count=count;
    }
    
    public void run(){
        for(int i=1;i&lt;=count;i++){
            System.out.println("Message from Second Thread: "+i);
            try{
                Thread.sleep(100);
            }catch(InterruptedException e){
                System.out.println("SecondThread interrupted: "+e);
            }
        }
    }

}

public class ThreadDemo {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the count for First Thread: ");
        int count1 = scanner.nextInt();

        System.out.print("Enter the count for Second Thread: ");
        int count2 = scanner.nextInt();

        FirstThread firstThread = new FirstThread(count1);
        SecondThread secondThread = new SecondThread(count2);

        firstThread.start();
        secondThread.start();

        // Check if threads are alive
        System.out.println("FirstThread is alive: " +firstThread.isAlive());
        System.out.println("SecondThread is alive: " +secondThread.isAlive());

        try {
            // Wait for threads to finish
            System.out.println("Waiting for FirstThread to finish.");
            // Write code for Main thread waits until FirstThread completes
            firstThread.join();
            System.out.println("FirstThread has finished.");
			System.out.println("Waiting for SecondThread to finish.");
            // Write code for Main thread waits until SecondThread completes
           secondThread.join();
            System.out.println("SecondThread has finished.");
        } catch (InterruptedException e) {
            System.out.println("Main thread interrupted: " + e);
        }

        // Check again if threads are alive after join
        System.out.println("FirstThread is alive after join: " +firstThread.isAlive());
        System.out.println("SecondThread is alive after join: " +secondThread.isAlive());

        System.out.println("Main thread has finished.");
    }
